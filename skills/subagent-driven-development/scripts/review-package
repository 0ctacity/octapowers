#!/usr/bin/env bash
# Generate a review package containing the working-tree changes since a
# recorded base, including uncommitted changes. Delegated tasks do not commit.
#
# Usage: review-package BASE [OUTFILE]
# Default OUTFILE: <repo-root>/.octapowers/sdd/review-<base7>-working.diff
set -euo pipefail

if [ $# -lt 1 ] || [ $# -gt 2 ]; then
  echo "usage: review-package BASE [OUTFILE]" >&2
  exit 2
fi

base=$1
git rev-parse --verify --quiet "$base" >/dev/null || { echo "bad BASE: $base" >&2; exit 2; }

if [ $# -eq 2 ]; then
  out=$2
else
  dir=$("$(cd "$(dirname "$0")" && pwd)/sdd-workspace")
  out="$dir/review-$(git rev-parse --short "$base")-working.diff"
fi

{
  echo "# Review package: changes since ${base}"
  echo
  echo "## Files changed"
  git diff --stat "$base"
  echo
  echo "## Diff"
  git diff -U10 "$base"
} > "$out"

echo "wrote ${out}: $(wc -c < "$out" | tr -d ' ') bytes"
